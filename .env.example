# Copy to .env and fill in as needed.

# --- Provider selection -------------------------------------------------
# "openai" (default) or "ollama" (fully local, no API key needed)
RAG_LLM_PROVIDER=openai

# --- OpenAI --------------------------------------------------------------
OPENAI_API_KEY=sk-...
RAG_OPENAI_CHAT_MODEL=gpt-4o-mini
RAG_OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Ollama (only used when RAG_LLM_PROVIDER=ollama) ---------------------
RAG_OLLAMA_CHAT_MODEL=llama3.1
RAG_OLLAMA_EMBED_MODEL=nomic-embed-text
RAG_OLLAMA_BASE_URL=http://localhost:11434

# --- Storage / chunking / retrieval --------------------------------------
RAG_PERSIST_DIR=./.rag_store
RAG_DEFAULT_COLLECTION=default
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_TEMPERATURE=0.0
